[Unit]
Description=Toujing member community
After=network.target

[Service]
Type=simple
User=toujing
Group=toujing
WorkingDirectory=/srv/toujing-community
ExecStart=/srv/toujing-community/.venv/bin/python scripts/run_community.py --port 18026 --origin https://community.example.com --database /var/lib/toujing-community/community.sqlite3
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/toujing-community

[Install]
WantedBy=multi-user.target
